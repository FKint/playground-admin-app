{
  "name": "Playground admin app",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": ["app", "database", "phpmyadmin", "selenium"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.22.1"
    }
  },
  "remoteUser": "vscode",
  // Claude Code keeps its login in ~/.claude/.credentials.json and its account/onboarding state in
  // ~/.claude.json, which is outside that directory. CLAUDE_CONFIG_DIR moves both into the volume, so
  // the login survives rebuilds. The volume name is fixed, so every checkout shares one login.
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    "source=playground-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, "phpmyadmin:80", "selenium:7900"],
  "portsAttributes": {
    "8000": { "label": "Laravel (php artisan serve)" },
    "phpmyadmin:80": { "label": "phpMyAdmin" },
    "selenium:7900": { "label": "Selenium noVNC (password: secret)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlin.laravel-blade",
        "mikestead.dotenv",
        "anthropic.claude-code"
      ]
    }
  }
}
